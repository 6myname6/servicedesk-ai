# =============================================================
# ServiceDesk AI - Git 忽略规则
# 原则：仓库只保留「源代码 + 构建脚本 + 文档 + SQL」，
#       编译产物、IDE 配置、本地敏感配置、日志、系统垃圾一律不入库。
# =============================================================

# -------------------------------------------------------------
# 1. 编译产物 / 构建目录
# -------------------------------------------------------------
/backend/target/
target/
/build/
/out/
/bin/
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
.flattened-pom.xml
.mvn/timing.properties

# -------------------------------------------------------------
# 2. 日志
# -------------------------------------------------------------
logs/
log/
*.log
*.log.*
*.log.gz
hs_err_pid*.log
replay_pid*.log

# -------------------------------------------------------------
# 3. IDE / 编辑器配置
# -------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.settings/
.classpath
.project
.factorypath
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.history/

# -------------------------------------------------------------
# 4. 本地敏感配置（只提交模板，不提交真实密钥）
# -------------------------------------------------------------
application-local.yml
application-local.yaml
application-local.properties
application-*-local.yml
application-secret.yml
application-secret.properties
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
*.p8

# -------------------------------------------------------------
# 5. 运行时产生的数据 / 上传文件
# -------------------------------------------------------------
/uploads/
/backend/uploads/
/storage/
/backend/storage/
/data/
/backend/data/
*.db
*.sqlite
*.sqlite3

# -------------------------------------------------------------
# 6. 前端依赖与构建产物（frontend 模块启用后生效）
# -------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
.umi/
.umi-production/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------------------------------------------
# 7. Python 脚本（design/draw_mockups.py 等）产生的缓存
# -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# -------------------------------------------------------------
# 8. 系统垃圾文件
# -------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*
.Spotlight-V100/
.Trashes/
$RECYCLE.BIN/
*.lnk
*.tmp
*.bak

# -------------------------------------------------------------
# 9. 本地私有文档（只保留在本地，不入库）
# -------------------------------------------------------------
/docs/编码规范.md
backend/src/main/resources/docs/开发排期.md
backend/src/main/resources/docs/编码规范.md
